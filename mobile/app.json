      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.orion.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "orion",
    "extra": {
      "eas": {
        "projectId": "da49e945-e225-43b9-b248-8b34a9e11234"
      }
    },
    "owner": "nardenlasouris",
