.venv/
.venv-neutts/
__pycache__/
*.pyc
*.part
data/
# Modèles téléchargés (scripts/download_models.py), sauf les wake words entraînés ici.
models/*
!models/openwakeword/
models/openwakeword/*
!models/openwakeword/jarvis_fr.onnx
!models/openwakeword/jarvis_fr.json
!models/openwakeword/orion_fr.onnx
!models/openwakeword/orion_fr.json
